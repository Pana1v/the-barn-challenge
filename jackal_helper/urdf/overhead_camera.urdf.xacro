<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="overhead_camera">

  <link name="overhead_camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="overhead_camera_optical"/>

  <joint name="overhead_camera_optical_joint" type="fixed">
    <parent link="overhead_camera_link"/>
    <child link="overhead_camera_optical"/>
    <!-- Rotate so camera looks straight down (-Z in world = +Z in optical) -->
    <origin xyz="0 0 0" rpy="${-3.14159/2} 0 ${-3.14159/2}"/>
  </joint>

  <gazebo reference="overhead_camera_link">
    <static>true</static>
    <gravity>false</gravity>
    <sensor type="camera" name="overhead_cam">
      <update_rate>10.0</update_rate>
      <camera name="overhead">
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>50</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>10.0</updateRate>
        <cameraName>overhead_cam</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>overhead_camera_optical</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
